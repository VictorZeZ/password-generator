<Project Sdk="WixToolset.Sdk/5.0.2">
	<PropertyGroup>
		<OutputName>pg-setup-1.0.2</OutputName>
		<OutputType>Package</OutputType>
		<Platform>x64</Platform>
		<PublishDir>$(MSBuildThisFileDirectory)..\artifacts\publish\win-x64</PublishDir>
		<DefineConstants>PublishDir=$(PublishDir)</DefineConstants>
		<OutputPath>$(MSBuildThisFileDirectory)..\artifacts\installer\</OutputPath>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
		<PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
		<BindPath Include="$(MSBuildThisFileDirectory)" />
		<BindVariable Include="WixUILicenseRtf=License.rtf" />
	</ItemGroup>
</Project>
