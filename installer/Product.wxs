<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Password Generator"
           Manufacturer="Meraj Esmaeili"
           Version="$(var.Version)"
           UpgradeCode="F1FAB449-5821-486A-B629-2F1C0FC2C938"
           Language="1033"
           Codepage="UTF-8"
           Scope="perMachine">

    <SummaryInformation Description="Password Generator Setup" Manufacturer="Meraj Esmaeili" />

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of [ProductName] is already installed. Setup will now exit."
      Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="ARPHELPLINK" Value="https://github.com/VictorZeZ/password-generator" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/VictorZeZ/password-generator" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Password Generator">
        <Component Id="ApplicationExecutable" Guid="*">
          <File Id="PgExe"
                Source="$(var.PublishDir)\pg.exe"
                KeyPath="yes" />

          <Environment Id="AddInstallFolderToPath"
                       Name="PATH"
                       Value="[INSTALLFOLDER]"
                       Permanent="no"
                       Part="last"
                       Action="set"
                       System="yes" />
        </Component>

        <Component Id="UninstallShortcut" Guid="*">
          <Shortcut Id="UninstallShortcutFile"
                    Name="Uninstall Password Generator"
                    Target="[System64Folder]msiexec.exe"
                    Arguments="/x [ProductCode]"
                    WorkingDirectory="INSTALLFOLDER"
                    Description="Uninstall Password Generator" />
          <RemoveFolder Id="RemoveInstallFolderOnUninstall" On="uninstall" />
          <RegistryValue Root="HKLM"
                          Key="Software\Password Generator"
                          Name="Installed"
                          Type="integer"
                          Value="1"
                          KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Password Generator" Level="1">
      <ComponentRef Id="ApplicationExecutable" />
      <ComponentRef Id="UninstallShortcut" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="Banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="Dialog.bmp" />

  </Package>
</Wix>
