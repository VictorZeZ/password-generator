<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Password Generator"
           Manufacturer="Meraj Esmaeili"
           Version="$(var.Version)"
           UpgradeCode="F1FAB449-5821-486A-B629-2F1C0FC2C938"
           Language="1033"
           Codepage="UTF-8"
           Scope="perMachine">

    <SummaryInformation Description="Password Generator Setup" Manufacturer="Meraj Esmaeili" />

    <!--
      Same UpgradeCode across every release lets Windows Installer recognize
      an existing install of any older version.
      - Newer MSI over older install  -> silently uninstalls the old files
        first, then installs the new ones (a "major upgrade").
      - Older MSI over a newer install -> blocked, with the message below.
      Do not change UpgradeCode in future releases, or upgrade detection
      breaks and both versions can end up installed side by side.
    -->
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of [ProductName] is already installed. Setup will now exit."
      Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Add/Remove Programs polish -->
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPHELPLINK" Value="https://github.com/your-org/password-generator" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/your-org/password-generator" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Password Generator">
        <Component Id="ApplicationExecutable" Guid="*">
          <File Id="PgExe"
                Source="$(var.PublishDir)\pg.exe"
                KeyPath="yes" />

          <!--
            Adds the install folder to the machine PATH so a freshly opened
            PowerShell or Command Prompt window can run `pg` with no extra
            setup. Removed automatically on uninstall.
          -->
          <Environment Id="AddInstallFolderToPath"
                       Name="PATH"
                       Value="[INSTALLFOLDER]"
                       Permanent="no"
                       Part="last"
                       Action="set"
                       System="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Password Generator" Level="1">
      <ComponentRef Id="ApplicationExecutable" />
    </Feature>

    <!-- Graphical wizard: Welcome -> License Agreement -> Install Folder -> Progress -> Finish -->
    <ui:WixUI Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="Banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="Dialog.bmp" />

  </Package>
</Wix>
